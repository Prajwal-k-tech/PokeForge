+    #[test]
+    fn test_helmet_single_activation_in_both_speed_tie_orders() {
+        for attacker_speed in [99, 100, 101] {
+            let mut state = State::default();
+            state.side_one.get_active().hp = 432;
+            state.side_one.get_active().maxhp = 432;
+            state.side_one.get_active().speed = attacker_speed;
+            state.side_two.get_active().speed = 100;
+            state.side_two.get_active().item = Items::ROCKYHELMET;
+            state.side_one.get_active().replace_move(PokemonMoveIndex::M0, Choices::TACKLE);
+            state.side_two.get_active().replace_move(PokemonMoveIndex::M0, Choices::SPLASH);
+            let original = format!("{:?}", state);
+            let branches = generate_instructions_from_move_pair(&mut state,
+                &MoveChoice::Move(PokemonMoveIndex::M0), &MoveChoice::Move(PokemonMoveIndex::M0), true);
+            assert_eq!(format!("{:?}", state), original);
+            assert!(!branches.is_empty());
+            for branch in branches {
+                let helmet_heals = branch.instruction_list.iter().filter(|instruction| matches!(instruction,
+                    Instruction::Heal(HealInstruction {side_ref: SideReference::SideOne, heal_amount: -72}))).count();
+                assert_eq!(helmet_heals, 1);
+                state.apply_instructions(&branch.instruction_list);
+                assert_eq!(state.side_one.get_active().hp, 360);
+                state.reverse_instructions(&branch.instruction_list);
+                assert_eq!(format!("{:?}", state), original);
+            }
+        }
+    }
